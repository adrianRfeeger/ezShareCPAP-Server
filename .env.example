# Replace with the dedicated LXC's LAN address, not the Proxmox host address.
LAN_IP=192.168.8.REPLACE
PUID=1000
PGID=1000

# Published image tag; set a sha-XXXXXXX or version tag to pin updates.
EZSHARE_VERSION=latest

# Set to none for a password-free dashboard on a trusted LAN.
WEB_AUTH_MODE=password
